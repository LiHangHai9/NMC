file -> prog
/'UTF-8'/

import lib.random;
import type.string;

int function rand_range (int min,int max) {
    return random.randint(min,max);
}

print("随机数(1-10)：");
int var a = rand_range(1,10);
print(a);

intList var list = new intList(1,2,3,4,5);
print(list);
var list = setList(0,100) <- list;
print(list);

print("遍历：");
for (i <- list) -> {
    print(i);
}
