file -> t
/'UTF-8'/

import type.string;

void block sleep (bool time, code = "sleep") <-> (code = "code") {
    for (code codeLine <- code) {
        run (codeLine);
        if (time) {
            break;
        }
    }
    run (sleep);
}

sleep(1) {
    print("收尾块");
} code {
    print("第一行");
    print("第二行");
}
